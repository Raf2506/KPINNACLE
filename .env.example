# Postgres (e.g. Neon). DATABASE_URL = pooled connection (runtime),
# DIRECT_URL = direct connection (migrations / `prisma db push`).
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Server-only. Never prefix with NEXT_PUBLIC_. Used by lib/llm.ts (later phase).
LLM_PROVIDER="anthropic"
LLM_API_KEY=""
