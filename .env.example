# Postgres (Neon). DATABASE_URL = pooled connection (runtime),
# DATABASE_URL_UNPOOLED = direct connection (migrations / `prisma db push`).
# Names match what Vercel's Neon integration auto-generates.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Server-only. Never prefix with NEXT_PUBLIC_. Used by lib/llm.ts.
# Gemini API key from Google AI Studio or Google Cloud Console.
LLM_PROVIDER="gemini"
LLM_API_KEY=""
