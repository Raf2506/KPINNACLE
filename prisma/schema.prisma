generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Category {
  SALES
  OPERATIONS
  COMPLIANCE
  DEVELOPMENT
}

enum Status {
  NOT_STARTED
  ON_TRACK
  AT_RISK
  BEHIND
}

enum AiFeature {
  RISK_DETECTION
  EXECUTIVE_INSIGHTS
}

model ReviewCycle {
  id         String      @id @default(cuid())
  name       String
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean     @default(true)
  kpis       Kpi[]
  aiInsights AiInsight[]
}

/// Cached last AI result per cycle-level feature, so the dashboard can show
/// "Generated Xmin ago" instead of calling the model on every page load.
model AiInsight {
  id        String      @id @default(cuid())
  feature   AiFeature
  cycle     ReviewCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  cycleId   String
  payload   Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([feature, cycleId])
}

model Employee {
  id         String @id @default(cuid())
  name       String
  role       String
  department String
  kpis       Kpi[]
}

model Kpi {
  id          String   @id @default(cuid())
  title       String
  description String
  category    Category
  weight      Float
  target      Float
  current     Float
  unit        String
  status      Status
  aiGenerated Boolean  @default(false)
  notes       String?
  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  employeeId  String
  cycle       ReviewCycle @relation(fields: [cycleId], references: [id])
  cycleId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
